<Window x:Class="SpeedrunCommunity.Views.Dialogs.GameDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:SpeedrunCommunity.ViewModels.Dialogs" 
        d:DataContext="{d:DesignInstance Type=dialogs:GameDetailsViewModel}"
        mc:Ignorable="d"
        Title="Game Details" 
        Height="560" Width="300" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="False"
        ui:TitleBar.Height="0"
        ui:WindowHelper.SystemBackdropType="Acrylic10">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <emoji:EmojiedTextBlock Text="🎮 Game Details" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Name" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                     ui:ControlHelper.PlaceholderText="Enter game name..."
                     Height="32" Margin="0,0,0,12"/>
            
            <TextBlock Text="Developer" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Developer, UpdateSourceTrigger=PropertyChanged}" 
                     ui:ControlHelper.PlaceholderText="Enter developer..."
                     Height="32" Margin="0,0,0,12"/>

            <TextBlock Text="Release Year" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ReleaseYear, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                     ui:ControlHelper.PlaceholderText="e.g. 2024"
                     Height="32" Margin="0,0,0,12"/>

            <TextBlock Text="Platform" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Platforms}" 
                      SelectedItem="{Binding SelectedPlatform}" 
                      Height="32" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Categories" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="4" Padding="0" Height="135">
                <ListView ItemsSource="{Binding Categories}" 
                          Background="Transparent" BorderThickness="0">
                    <ListView.Resources>
                        <Thickness x:Key="ListViewItemCompactSelectedBorderThemeThickness">1</Thickness>
                    </ListView.Resources>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="MinHeight" Value="32"/>
                            <Setter Property="Height" Value="33"/>
                            <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Category.Name}" 
                                       ToolTip="{Binding Category.Description}"
                                       Margin="0"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}" 
                    IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="100" Height="36" Margin="0,0,8,0"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    IsCancel="True"
                    Width="100" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
