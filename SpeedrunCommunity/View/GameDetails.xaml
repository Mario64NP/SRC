<Window x:Class="SpeedrunCommunity.View.GameDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeedrunCommunity.View"
        mc:Ignorable="d"
        Title="Game" WindowStartupLocation="CenterOwner" Height="500" Width="400">

    <Grid VerticalAlignment="Center" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Name: " Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtName" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,5"/>

        <Label Content="Developer: " Grid.Row="1" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtDeveloper" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,5"/>

        <Label Content="Release year: " Grid.Row="2" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox x:Name="txtReleaseYear" Grid.Row="2" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,5"/>

        <Label Content="Platform: " Grid.Row="3" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbPlatform" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,5" HorizontalAlignment="Stretch"/>

        <Label Content="Allowed categories: " Grid.Row="4" Margin="0,15,0,5" VerticalAlignment="Bottom"/>
        <ListView Name="lvCategories" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,5,0,15">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="80"/>
                    <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="270"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOK" Content="OK" Margin="5" IsDefault="True" Click="btnOK_Click" Width="80" Height="32" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="btnCancel" Content="Cancel" Margin="5" IsCancel="True" Width="80" Height="32"/>
        </StackPanel>

    </Grid>
</Window>
