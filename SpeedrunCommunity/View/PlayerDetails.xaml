<Window x:Class="SpeedrunCommunity.PlayerDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeedrunCommunity"
        mc:Ignorable="d"
        Title="Player" Height="250" Width="350" WindowStartupLocation="CenterOwner">

    <Grid VerticalAlignment="Center" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Label Content="Nick: " HorizontalAlignment="Left" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Name="txtNick" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,5"/>
        
        <Label Content="Age: " Grid.Row="1" HorizontalAlignment="Left" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Name="txtAge" Grid.Row="1" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,5"/>
        
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="btnOK" Content="OK" Margin="5" IsDefault="True" Click="btnOK_Click" Width="80" Height="32" Style="{StaticResource AccentButtonStyle}"/>
            <Button Name="btnCancel" Content="Cancel" Margin="5" IsCancel="True" Width="80" Height="32"/>
        </StackPanel>
    </Grid>
</Window>
