<Window x:Class="SpeedrunCommunity.Views.Dialogs.PlayerDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:SpeedrunCommunity.ViewModels.Dialogs" 
        d:DataContext="{d:DesignInstance Type=dialogs:PlayerDetailsViewModel}"
        mc:Ignorable="d"
        Title="Player Details" 
        Height="320" Width="300" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="False"
        ui:TitleBar.Height="0"
        ui:WindowHelper.SystemBackdropType="Acrylic10">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <emoji:EmojiedTextBlock Text="👤 Player Details" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Nickname" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Nick, UpdateSourceTrigger=PropertyChanged}" 
                     ui:ControlHelper.PlaceholderText="Enter nickname..."
                     Height="32" Margin="0,0,0,16"/>
            
            <TextBlock Text="Age" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Age, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                     ui:ControlHelper.PlaceholderText="Enter age..."
                     Height="32"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}" 
                    IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="100" Height="36" Margin="0,0,8,0"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    IsCancel="True"
                    Width="100" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
