<Window x:Class="SpeedrunCommunity.Views.Dialogs.ResultDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:emoji="http://schemas.inkore.net/lib/ui/wpf/emojis"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:dialogs="clr-namespace:SpeedrunCommunity.ViewModels.Dialogs" 
        d:DataContext="{d:DesignInstance Type=dialogs:ResultDetailsViewModel}"
        mc:Ignorable="d"
        Title="Result Details" 
        Height="500" Width="300" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        ui:TitleBar.IsIconVisible="False"
        ui:TitleBar.Height="0"
        ui:WindowHelper.SystemBackdropType="Acrylic10">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <emoji:EmojiedTextBlock Text="🏆 Result Details" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,20"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Player" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Players}" 
                      SelectedItem="{Binding SelectedPlayer}" 
                      IsEnabled="{Binding IsKeyFieldsEnabled}"
                      Height="32" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>
            
            <TextBlock Text="Game" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Games}" 
                      SelectedItem="{Binding SelectedGame}" 
                      IsEnabled="{Binding IsKeyFieldsEnabled}"
                      Height="32" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Category" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableCategories}" 
                      SelectedItem="{Binding SelectedCategory}" 
                      IsEnabled="{Binding IsKeyFieldsEnabled}"
                      Height="32" Margin="0,0,0,12" HorizontalAlignment="Stretch"/>

            <TextBlock Text="Time (seconds)" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Time, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" 
                     ui:ControlHelper.PlaceholderText="Enter time in seconds..."
                     Height="32" Margin="0,0,0,12"/>

            <TextBlock Text="Date" FontSize="12" Opacity="0.7" Margin="0,0,0,4"/>
            <DatePicker SelectedDate="{Binding Date}" 
                        Height="32" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" 
                    Command="{Binding SaveCommand}" 
                    IsDefault="True"
                    Style="{StaticResource AccentButtonStyle}"
                    Width="100" Height="36" Margin="0,0,8,0"/>
            <Button Content="Cancel" 
                    Command="{Binding CancelCommand}" 
                    IsCancel="True"
                    Width="100" Height="36"/>
        </StackPanel>
    </Grid>
</Window>
