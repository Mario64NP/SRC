<Window x:Class="SpeedrunCommunity.View.ResultDetails"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpeedrunCommunity.View"
        mc:Ignorable="d"
        Title="ResultDetails" WindowStartupLocation="CenterOwner" Height="400" Width="350">

    <Grid VerticalAlignment="Center" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Player: " Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Name="cmbPlayer" Grid.Column="1" Height="32" Margin="0,5"/>

        <Label Content="Game: " Grid.Row="1" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Name="cmbGame" Grid.Row="1" Grid.Column="1" Height="32" SelectionChanged="cmbGame_SelectionChanged" Margin="0,5"/>

        <Label Content="Category: " Grid.Row="2" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <ComboBox Name="cmbCategory" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,5"/>

        <Label Content="Time: " Grid.Row="3" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <TextBox Name="txtTime" Grid.Row="3" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Margin="0,5"/>

        <Label Content="Date: " Grid.Row="4" Margin="0,5,10,5" VerticalAlignment="Center"/>
        <DatePicker Name="dtpDate" Grid.Row="4" Grid.Column="1" Height="32" Margin="0,5"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="btnOK" Content="OK" Margin="5" IsDefault="True" Click="btnOK_Click" Height="32" Width="80" Style="{StaticResource AccentButtonStyle}"/>
            <Button x:Name="btnCancel" Content="Cancel" Margin="5" IsCancel="True" Height="32" Width="80"/>
        </StackPanel>

    </Grid>
</Window>
